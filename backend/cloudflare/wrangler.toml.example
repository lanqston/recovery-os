name = "recovery-os-research-api"
main = "worker.js"
compatibility_date = "2026-09-01"

[vars]
ALLOWED_ORIGIN = "https://lanqston.github.io"
WATCH_MONITORING_ENABLED = "false"
INFORMATION_MONITORING_ENABLED = "false"
ALPHA_VANTAGE_APPROVED = "false"
# Public archive reads require no secrets. Optional SEC_USER_AGENT, ALPHA_VANTAGE_API_KEY and RECOVERY_CLIENT_TOKEN stay server-side.

# D1 is optional for archive reads; required for durable provider budgets and saved history.
# Apply schema.sql to the existing D1 database before enabling adapters.
# Create a D1 database, then uncomment and fill these values.
# [[d1_databases]]
# binding = "DB"
# database_name = "recovery-os-research"
# database_id = "YOUR_D1_DATABASE_ID"

# Enable only after reviewing the optional official-data monitoring configuration.
# [triggers]
# crons = ["*/15 * * * *"]
