name = "recovery-os-research-api"
main = "worker.js"
compatibility_date = "2026-09-01"

[vars]
ALLOWED_ORIGIN = "https://lanqston.github.io"
WATCH_MONITORING_ENABLED = "false"
INFORMATION_MONITORING_ENABLED = "false"
ALPHA_VANTAGE_APPROVED = "false"
# SEC_USER_AGENT, MASSIVE_API_KEY, ALPHA_VANTAGE_API_KEY and RECOVERY_CLIENT_TOKEN are Worker secrets.

# D1 is required for durable provider budgets and immutable research history.
# Apply schema.sql to the existing D1 database before enabling adapters.
# Create a D1 database, then uncomment and fill these values.
# [[d1_databases]]
# binding = "DB"
# database_name = "recovery-os-research"
# database_id = "YOUR_D1_DATABASE_ID"

# Enable only after your stock plan supports the quote data you intend to monitor.
# [triggers]
# crons = ["*/15 * * * *"]
